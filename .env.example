DATABASE_URL="postgresql://USER@localhost:5432/submithub?schema=public"

# --- Google OAuth (create at console.cloud.google.com > APIs & Services > Credentials) ---
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# --- NextAuth ---
AUTH_SECRET=""
AUTH_URL="http://localhost:3000"
AUTH_TRUST_HOST="true"

# --- Access control ---
# Comma-separated allowed email domains. Leave blank to allow any roster email.
ALLOWED_EMAIL_DOMAIN=""

# --- Google Drive ---
# Root Drive folder ID that the CR owns. Leave blank to auto-create "SubmitHub" in CR's My Drive.
DRIVE_ROOT_FOLDER_ID=""
